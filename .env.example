# Copy to .env. Keep actual secrets outside version control.
APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Production requires an explicit, stable SECRET_KEY of at least 32 characters.
SECRET_KEY=
DATABASE_URL=sqlite:///webdev_crm.sqlite3
BUSINESS_TIMEZONE=Asia/Manila
DEFAULT_CURRENCY=PHP
SESSION_COOKIE_SECURE=false
EMAIL_TEST_MODE=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Set false only after test-mode review and SMTP configuration.
AUTOMATIONS_PAUSED=false
# Run one scheduler process separately; never start it inside web workers.
RATELIMIT_STORAGE_URI=memory://
